{
  "name": "memebot_discord",
  "version": "1.0.0",
  "description": "this is a demo project for teaching how to build a discord bot",
  "type": "module",
  "engines": {
    "node": ">=26 <27"
  },
  "scripts": {
    "build": "rm -rf build && esbuild src/*.js src/**/*.js --platform=node --format=cjs  --outdir=build --outbase=src && echo '{\"type\":\"commonjs\"}' > build/package.json",
    "start": "npm run build && node -r dotenv/config build/app.js",
    "dev": "nodemon",
    "prod": "node build/app.js",
    "test": "mocha -r esbuild-runner/register ./tests/*.spec.js --exit",
    "test:coverage": "node scripts/coverage.mjs",
    "test:smoke": "mocha -r esbuild-runner/register \"tests/smoke/**/*.spec.js\" --exit"
  },
  "keywords": [
    "discord",
    "bot",
    "javascript",
    "nodejs"
  ],
  "author": "Shubham Jaiswal <@shubhamjaiswal27>",
  "license": "MIT",
  "dependencies": {
    "ascii-table": "^0.0.9",
    "axios": "^1.21.0",
    "discord.js": "^14.5.0",
    "node-ical": "^0.25.6"
  },
  "devDependencies": {
    "c8": "^12.0.0",
    "chai": "^4.3.6",
    "dotenv": "^16.0.2",
    "esbuild": "^0.28.2",
    "esbuild-runner": "^2.2.1",
    "fast-check": "^4.10.2",
    "mocha": "^10.0.0",
    "nodemon": "^3.1.14"
  },
  "overrides": {
    "mocha": {
      "yargs": "17.7.3"
    }
  }
}
